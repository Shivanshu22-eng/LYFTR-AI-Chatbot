# ============================================================
# LYFTR AI — Environment Variables
# Copy to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Gemini / LiteLLM ---
LLM_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
LITELLM_MODEL=gemini/gemini-3.5-flash-lite
LITELLM_LOCAL_MODEL_COST_MAP=True

# --- Database ---
DATABASE_PATH=./lyftr.db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# --- Admin Bootstrap ---
# The first admin user is created automatically on startup from these variables.
# Only set these on first deploy; remove after the admin account is created.
# NEVER hardcode or commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# --- Testing / Development ---
ENABLE_FAILURE_SIMULATION=true
