# ============================================================
# LYFTR AI Chatbot — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- API Keys (comma-separated for failover) ----------------
# Supports multiple Gemini / OpenAI keys for automatic failover.
# The system will rotate through them and retry on 429/5xx errors.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2

# --- Fallback: single key (used if LLM_API_KEYS is empty) ---
# GEMINI_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=sk-your-openai-key-here

# --- Model to use (any LiteLLM-supported model identifier) --
# For Gemini: gemini/gemini-3.5-flash-lite, gemini/gemini-1.5-pro
# For OpenAI: gpt-4o, gpt-3.5-turbo
LITELLM_MODEL=gemini/gemini-3.5-flash-lite

# --- Database -----------------------------------------------
DATABASE_PATH=./lyftr.db

# --- CORS (comma-separated origins) -------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Backend server -----------------------------------------
BACKEND_PORT=8000
ENABLE_FAILURE_SIMULATION=false
